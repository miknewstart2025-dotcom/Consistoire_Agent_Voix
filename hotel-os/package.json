{
  "name": "hotel-os",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/** run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "db:up": "bash infra/dev-postgres.sh start",
    "db:down": "bash infra/dev-postgres.sh stop"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/node": "22.18.0"
  }
}
