<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="com.hotelos.permission.DEVICE_SERVICE" />
    <queries><package android:name="com.hotelos.dpc" /></queries>

    <application
        android:allowBackup="false"
        android:banner="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <!-- Cleartext allowed only because hotel headends often serve HTTP/UDP on the LAN. -->
        <activity
            android:name=".PlayerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".SessionResetReceiver"
            android:exported="true"
            android:permission="com.hotelos.permission.DEVICE_SERVICE">
            <intent-filter><action android:name="com.hotelos.action.RESET_SESSION" /></intent-filter>
        </receiver>
    </application>
</manifest>
