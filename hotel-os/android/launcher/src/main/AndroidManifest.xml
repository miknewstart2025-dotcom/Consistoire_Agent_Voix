<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="com.hotelos.permission.DEVICE_SERVICE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.hotelos.dpc" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Controller → launcher signals (RESET_SESSION / REFRESH / RESTART). Signature-protected. -->
        <receiver
            android:name=".ControlReceiver"
            android:exported="true"
            android:permission="com.hotelos.permission.DEVICE_SERVICE">
            <intent-filter>
                <action android:name="com.hotelos.action.RESET_SESSION" />
                <action android:name="com.hotelos.action.REFRESH" />
                <action android:name="com.hotelos.action.RESTART" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
